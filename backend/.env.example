# ============================================================
# Backend (.env)
# Copie para `backend/.env` e preencha os valores necessários.
# IMPORTANTE: não comite chaves reais.
# ============================================================

# ---------------------------
# App
# ---------------------------
APP_NAME="Holocron Analytics API"
APP_VERSION="0.1.0"

# ---------------------------
# CORS
# Aceita CSV (separado por vírgula) ou JSON (["..."])
# ---------------------------
CORS_ALLOW_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ---------------------------
# Auth (JWT) + Google OAuth
# ---------------------------
# Segredo do JWT (GERE UM FORTE PARA PRODUÇÃO; não comite chaves reais)
JWT_SECRET_KEY="CHANGE_ME"
JWT_ISSUER="holocron-analytics"
JWT_ACCESS_TTL_SECONDS="900"         # 15 minutos
JWT_REFRESH_TTL_SECONDS="2592000"    # 30 dias

# Client ID do Google (NÃO é segredo, mas coloque via .env e não hardcode)
GOOGLE_OAUTH_CLIENT_ID=""

# Cookies (refresh token)
AUTH_COOKIE_SECURE="false"          # true em produção HTTPS
AUTH_COOKIE_SAMESITE="lax"          # lax|strict|none

# ---------------------------
# Database (PostgreSQL)
# Use UM dos formatos abaixo:
# - DATABASE_URL (recomendado)
# - ou variáveis separadas
# ---------------------------
# DATABASE_URL="postgresql+psycopg2://USER:PASSWORD@HOST:5432/star_wars_app"
DATABASE_HOST=""
DATABASE_PORT="5432"
DATABASE_NAME=""
DATABASE_USERNAME=""
DATABASE_PASSWORD=""

# ---------------------------
# Postgres container (Docker Compose)
# Necessário para o serviço `db` (imagem oficial do Postgres).
# Estes valores ficam no `backend/.env` (ignorado) — NÃO comite credenciais reais.
# ---------------------------
POSTGRES_DB="CHANGE_ME"
POSTGRES_USER="CHANGE_ME"
POSTGRES_PASSWORD="CHANGE_ME"

# ---------------------------
# Cache
# ---------------------------
CACHE_TTL_SECONDS="3600"

# ---------------------------
# SWAPI
# ---------------------------
SWAPI_BASE_URL="https://swapi.dev/api"

# ---------------------------
# I.A. (Star Wars) — OBRIGATÓRIO para o chat funcionar
# O chat usa IA para todas as respostas (Yoda/Vader)
# Sem IA habilitada, o chat retorna erro
# ---------------------------
AI_PROVIDER="openai"   # opções: openai | gemini
AI_ENABLED="true"      # DEVE ser true para o chat funcionar

# Prompt/base de contexto (opcional)
AI_SYSTEM_PROMPT="Você é um assistente especialista no universo de Star Wars. Responda em português."

# OpenAI (OBRIGATÓRIO se AI_PROVIDER=openai)
OPENAI_API_KEY=""      # Sua API key da OpenAI
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL=""   # NÃO defina se usar API oficial. String vazia causa bug!
OPENAI_FALLBACK_MODELS="gpt-4o,gpt-4.1-mini,gpt-4.1"  # CSV ou JSON (["..."])

# Gemini (Google)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ---------------------------
# Migrations (Alembic)
# ---------------------------
# Depois de configurar o banco em `backend/.env`, rode:
# - via Docker Compose: `docker compose -f docker-compose.dev.yml exec backend poetry run alembic upgrade head`
# - local (se tiver poetry): `poetry run alembic upgrade head`

