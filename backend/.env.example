# ============================================================
# Backend (.env)
# Copie para `backend/.env` e preencha os valores necessários.
# IMPORTANTE: não comite chaves reais.
# ============================================================

# ---------------------------
# App
# ---------------------------
APP_NAME="Holocron Analytics API"
APP_VERSION="0.1.0"

# ---------------------------
# CORS
# Aceita CSV (separado por vírgula) ou JSON (["..."])
# ---------------------------
CORS_ALLOW_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ---------------------------
# Cache
# ---------------------------
CACHE_TTL_SECONDS="3600"

# ---------------------------
# SWAPI
# ---------------------------
SWAPI_BASE_URL="https://swapi.dev/api"

# ---------------------------
# I.A. (Star Wars) — escolha entre OpenAI e Gemini
# Preencha APENAS o provedor que for usar
# ---------------------------
AI_PROVIDER="openai"   # opções: openai | gemini
AI_ENABLED="false"

# Prompt/base de contexto (opcional)
AI_SYSTEM_PROMPT="Você é um assistente especialista no universo de Star Wars. Responda em português."

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL=""     # opcional (deixe vazio para padrão)
OPENAI_FALLBACK_MODELS="gpt-4o,gpt-4.1-mini,gpt-4.1"  # CSV ou JSON (["..."])

# Gemini (Google)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

