# ============================================================
# Root .gitignore (frontend + backend)
# ============================================================

# ----------------------------
# Environment / secrets
# ----------------------------
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# direnv
.envrc
.direnv/

# ----------------------------
# Logs
# ----------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----------------------------
# OS / Editor
# ----------------------------
.DS_Store
Thumbs.db
Desktop.ini

.idea/
.vscode/

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*.pyo

.pytest_cache/
.coverage
coverage/
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/
.pyre/
.tox/

# Virtual environments
.venv/
venv/
ENV/
env/

# ----------------------------
# Node / Frontend (Vite/React)
# ----------------------------
node_modules/
dist/
build/
.vite/

# TypeScript
*.tsbuildinfo

# Test output
.vitest/

